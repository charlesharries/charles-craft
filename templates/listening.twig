{% import "_partials/head.twig" as head %}
{% import "_partials/listens.twig" as listens %}

{% extends "_layout.twig" %}

{%- set days = craft.tracks.listening() -%}
{%- set chart = craft.tracks.chart() -%}
{%- set description = "What I've been listening to over the last five days." -%}

{% block title %}
	Listening
{% endblock %}

{% block metaDescription %}{{ description }}{% endblock %}

{% block head %}
	{{ head.meta("Listening", description, url(url() ~ "listening")) }}
{% endblock %}

{% macro chart(chart) %}
	<figure class="listenchart mt-md" style="--weeks: {{ chart.weeks }}">
		<svg
			class="listenchart_grid"
			viewBox="0 0 {{ chart.width }} {{ chart.height }}"
			role="group"
			aria-label="Plays a day over the last {{ chart.days|length }} days: {{ chart.total }} in all, up to {{ chart.max }} in a day."
		>
			{% for day in chart.days %}
				{%- set label = day.day|date("D j M Y") ~ " — " ~ day.count ~ (day.count == 1 ? " play" : " plays") -%}

				{% if day.count %}
					<a href="{{ url("listening/" ~ day.day) }}" aria-label="{{ label }}">
						{{ _self.day(chart, day, label) }}
					</a>
				{% else %}
					{{ _self.day(chart, day, label) }}
				{% endif %}
			{% endfor %}
		</svg>
	</figure>
{% endmacro %}

{% macro day(chart, day, label) %}
	<rect
		class="listenchart_day"
		data-level="{{ day.level }}"
		x="{{ day.x }}"
		y="{{ day.y }}"
		width="{{ chart.cell }}"
		height="{{ chart.cell }}"
		rx="2"
	>
		<title>{{ label }}</title>
	</rect>
{% endmacro %}

{% block content %}
	<main class="listening container mt-lg">
		<h1>Listening</h1>

		{% if chart.total %}
			{{ _self.chart(chart) }}
		{% endif %}

		{% for day in days %}
			{{ listens.day(day) }}
		{% else %}
			<p class="mt-lg muted">Nothing played in the last five days.</p>
		{% endfor %}
	</main>
{% endblock %}
