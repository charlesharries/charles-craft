{% import "_partials/head.twig" as head %}

{% extends "_layout.twig" %}

{%- set days = craft.tracks.listening() -%}
{%- set today = "now"|date("Y-m-d") -%}
{%- set yesterday = "yesterday"|date("Y-m-d") -%}

{% block title %}
	Listening
{% endblock %}

{% block metaDescription %}What Charles Harries has been listening to over the last five days.{% endblock %}

{% block head %}
	{{ head.meta(
        "Listening",
        "What I've been listening to over the last five days.",
        url(url() ~ "listening")
    ) }}
{% endblock %}

{% block content %}
	<main class="listening container mt-lg">
		<h1>Listening</h1>
		<p class="mt-sm muted">Everything I've played over the last five days, by way of
			<a href="https://teal.fm">teal.fm</a>. Albums I sat through are the album; everything else is the song.</p>

		{% for day in days %}
			<section class="mt-lg">
				<h2 class="serif highlight text-md keyline">
					{%- if day.day == today -%}
						Today
					{%- elseif day.day == yesterday -%}
						Yesterday
					{%- else -%}
						{{ day.day|date("l j F") }}
					{%- endif -%}
				</h2>

				<ol role="list" class="listens stack mt-md">
					{% for listen in day.entries %}
						<li class="listen flex align-center">
							<div class="listen_art rounded">
								{% if listen.art %}
									<img src="{{ listen.art }}" alt="" class="no-lightbox" width="64" height="64" loading="lazy"/>
								{% endif %}
							</div>

							<div class="ml-sm flex-1">
								<p class="bold">{{ listen.type == "album" ? listen.releaseName : listen.trackName }}</p>
								<p class="muted text-sm">{{ listen.artist }}</p>
							</div>

							<p class="listen_meta muted text-sm sans text-right">
								<time datetime="{{ listen.playedTime|atom }}">{{ listen.playedTime|date("H:i") }}</time>
								{% if listen.type == "album" %}
									<span>{{ listen.trackCount }} tracks</span>
								{% elseif listen.playCount > 1 %}
									<span>&times;{{ listen.playCount }}</span>
								{% endif %}
							</p>
						</li>
					{% endfor %}
				</ol>
			</section>
		{% else %}
			<p class="mt-lg muted">Nothing played in the last five days.</p>
		{% endfor %}
	</main>
{% endblock %}
