{% import "_partials/head.twig" as head %}

{% extends "_layout.twig" %}

{%- set days = craft.tracks.listening() -%}
{%- set chart = craft.tracks.chart() -%}
{%- set description = "What I've been listening to over the last five days." -%}

{% block title %}
	Listening
{% endblock %}

{% block metaDescription %}{{ description }}{% endblock %}

{% block head %}
	{{ head.meta("Listening", description, url(url() ~ "listening")) }}
{% endblock %}

{% macro art(listen, label = "") %}
	<div class="listen_art rounded"{% if label %} title="{{ label }}"{% endif %}>
		{% if listen.art %}
			<img src="{{ listen.art }}" alt="{{ label }}" class="no-lightbox" loading="lazy"/>
		{% endif %}
	</div>
{% endmacro %}

{% macro album(listen) %}
	{% import _self as m %}

	<li class="listen flex align-center">
		{{ m.art(listen) }}

		<div class="ml-sm flex-1">
			<p class="bold">{{ listen.releaseName }} <span class="trackCount ml-sm">{{ listen.trackCount }}</span></p>
			<p class="muted text-sm">{{ listen.artist }}</p>
		</div>

		<p class="listen_meta muted text-sm sans text-right">
			<time datetime="{{ listen.playedTime|atom }}">{{ listen.playedTime|date("H:i") }}</time>
		</p>
	</li>
{% endmacro %}

{% macro songs(listens) %}
	{% import _self as m %}

	<li class="listen_songs">
		<ul role="list" class="listen_strip cluster" data-size="2xs">
			{% for listen in listens %}
				<li>
					{{ m.art(listen, listen.trackName ~ " — " ~ listen.artist ~ (listen.playCount > 1 ? " (×" ~ listen.playCount ~ ")" : "")) }}
				</li>
			{% endfor %}
		</ul>
	</li>
{% endmacro %}

{% macro chart(chart) %}
	<figure class="listenchart mt-md">
		<svg
			class="listenchart_plot mt-sm"
			viewBox="0 0 {{ chart.width }} {{ chart.height }}"
			preserveAspectRatio="none"
			role="img"
			aria-label="Plays a day over the last {{ chart.days|length }} days: {{ chart.total }} in all, up to {{ chart.max }} in a day."
		>
			<polygon class="listenchart_area" points="0,{{ chart.baseline }} {{ chart.line }} {{ chart.width }},{{ chart.baseline }}"/>
			<polyline class="listenchart_line" points="{{ chart.line }}"/>
			<line class="listenchart_rule" x1="0" y1="{{ chart.baseline }}" x2="{{ chart.width }}" y2="{{ chart.baseline }}"/>

			{# A column a day, for the pointer to find - the line itself is too thin to hover. #}
			{% for day in chart.days %}
				<rect class="listenchart_day" x="{{ day.x - chart.step / 2 }}" y="0" width="{{ chart.step }}" height="{{ chart.height }}">
					<title>{{ day.day|date("D j M") }} — {{ day.count }} {{ day.count == 1 ? "play" : "plays" }}</title>
				</rect>
			{% endfor %}
		</svg>

		<p class="listenchart_axis flex justify-between muted text-sm sans">
			<span>{{ (chart.days|first).day|date("j M") }}</span>
			<span>{{ (chart.days|last).day|date("j M") }}</span>
		</p>
	</figure>
{% endmacro %}

{% block content %}
	<main class="listening container mt-lg">
		<h1>Listening</h1>

		{% if chart.total %}
			{{ _self.chart(chart) }}
		{% endif %}

		{% for day in days %}
			<section class="mt-xl">
				<h2 class="serif text-md keyline">
					<span class="highlight">{{ day.day|date("l j F") }}</span>
					<span class="trackCount ml-sm">{{ day.total }}</span>
				</h2>

				<ol role="list" class="listens stack mt-md" data-size="md">
					{% for row in day.rows %}
						{% if row.type == "album" %}
							{{ _self.album(row.listens|first) }}
						{% else %}
							{{ _self.songs(row.listens) }}
						{% endif %}
					{% endfor %}
				</ol>
			</section>
		{% else %}
			<p class="mt-lg muted">Nothing played in the last five days.</p>
		{% endfor %}
	</main>
{% endblock %}
